{
  "name": "welyjs",
  "version": "0.0.13",
  "type": "module",
  "description": "Lightweight Web Component framework powered by a single defineComponent() factory",
  "main": "./dist/wely.umd.js",
  "module": "./dist/wely.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wely.es.js",
      "require": "./dist/wely.umd.js",
      "default": "./dist/wely.es.js"
    },
    "./playground/app": {
      "types": "./src/playground/app.ts",
      "import": "./src/playground/app.ts",
      "default": "./src/playground/app.ts"
    },
    "./vitest-consumer": "./vitest.consumer.config.ts",
    "./test": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "bin": {
    "wely": "./bin/wely.mjs"
  },
  "files": [
    "dist",
    "bin",
    "index.html",
    "src/build",
    "src/playground",
    "vite.library.config.ts",
    "vite.dev.config.ts",
    "vitest.consumer.config.ts",
    "src/testing"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:page": "node bin/wely.mjs page",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "wely": "node bin/wely.mjs",
    "build:bundle": "WELY_BUILD_MODE=bundle vite build --emptyOutDir false",
    "build:chunks": "WELY_BUILD_MODE=chunks vite build --emptyOutDir false",
    "build:all": "npm run build && npm run build:bundle && npm run build:chunks",
    "prepublishOnly": "npm run build",
    "test:e2e": "vitest run e2e",
    "test:browser": "npm run build && npm run build:bundle && playwright test",
    "docs:playground-ss": "node scripts/capture-playground-screenshots.mjs"
  },
  "browserslist": [
    "Chrome >= 73",
    "Firefox >= 101",
    "Safari >= 16.4",
    "Edge >= 79"
  ],
  "wely": {
    "componentsDir": "src/components"
  },
  "sideEffects": [
    "./src/components/**",
    "./src/bundle.ts",
    "./dist/wely.bundle.es.js",
    "./dist/wely.bundle.umd.js"
  ],
  "license": "MIT",
  "repository": "https://github.com/litepacks/welyjs",
  "homepage": "https://litepacks.github.io/welyjs/",
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/vite": "^4.2.1",
    "codemirror": "^6.0.2",
    "commander": "^14.0.3",
    "esbuild": "^0.25.10",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "jsdom": "^28.1.0",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
